{
  "version": 2,
  "builds": [
    {
      "src": "apps/wayfarer-mfe-home/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "apps/wayfarer-mfe-catalog/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "apps/wayfarer-mfe-blog/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/explore/(.*)",
      "dest": "/apps/wayfarer-mfe-catalog/$1"
    },
    {
      "src": "/blog/(.*)",
      "dest": "/apps/wayfarer-mfe-blog/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/wayfarer-mfe-home/$1"
    }
  ]
}
