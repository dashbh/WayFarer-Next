{
  "name": "wayfarer-next",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@grafana/faro-web-sdk": "^1.14.1",
    "@grafana/faro-web-tracing": "^1.14.1",
    "@sentry/nextjs": "^9.6.1",
    "prom-client": "^15.1.3",
    "web-vitals": "^4.2.4"
  }
}
